@page
<html>
    <body>
        <h1>What is your name?</h1>
        <form method='POST' action='/submit'>
            @Html.AntiForgeryToken()
            <input type='text' name='username' />
            <button type='submit'>Submit</button>
        </form>

        <h1>Word Counter:</h1>
        <form method='POST' action='/words'>
            @Html.AntiForgeryToken()
            <input type='text' name='words' />
            <button type='submit'>Submit</button>
        </form>
    </body>
</html>